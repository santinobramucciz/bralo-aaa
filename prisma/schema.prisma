generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  role          String    @default("admin")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  description   String    @default("")
  shortDesc     String    @default("")
  priceEUR      Float
  costEUR       Float     @default(0)
  marginPct     Float     @default(0)
  imageUrl      String    @default("")
  images        String    @default("[]")
  category      String    @default("")
  tags          String    @default("[]")
  stock         Int       @default(0)
  sku           String?   @unique
  sourceUrl     String?
  source        String?
  status        String    @default("active")
  featured      Boolean   @default(false)
  views         Int       @default(0)
  salesCount    Int       @default(0)
  rating        Float     @default(0)
  reviewCount   Int       @default(0)
  seoTitle      String?
  seoDesc       String?
  variants      String    @default("[]")
  metadata      String    @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  orderItems    OrderItem[]
  cartItems     CartItem[]

  @@index([status, category])
  @@index([featured, salesCount])
}

model Order {
  id            String    @id @default(cuid())
  orderNumber   String    @unique
  customerName  String
  customerEmail String
  customerPhone String?
  address       String
  city          String
  postalCode    String
  country       String    @default("España")
  notes         String?
  status        String    @default("pending")
  paymentStatus String    @default("pending")
  paymentMethod String?
  totalEUR      Float
  subtotalEUR   Float
  shippingEUR   Float     @default(0)
  trackingNumber String?
  trackingUrl   String?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items         OrderItem[]
  logs          OrderLog[]

  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String    @id @default(cuid())
  orderId       String
  productId     String?
  productName   String
  productImage  String?
  quantity      Int       @default(1)
  priceEUR      Float
  totalEUR      Float

  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model OrderLog {
  id            String    @id @default(cuid())
  orderId       String
  status        String
  message       String?
  agent         String?
  createdAt     DateTime  @default(now())

  order         Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model CartItem {
  id            String    @id @default(cuid())
  sessionId     String
  productId     String
  quantity      Int       @default(1)
  createdAt     DateTime  @default(now())

  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([sessionId, productId])
}

model AgentLog {
  id            String    @id @default(cuid())
  agent         String
  action        String
  input         String    @default("")
  output        String    @default("")
  status        String    @default("success")
  durationMs    Int       @default(0)
  createdAt     DateTime  @default(now())

  @@index([agent, createdAt])
  @@index([status])
}

model DailyReport {
  id            String    @id @default(cuid())
  date          String    @unique
  summary       String
  productsFound Int       @default(0)
  productsApproved Int    @default(0)
  productsPublished Int   @default(0)
  totalSalesEUR Float     @default(0)
  totalOrders   Int       @default(0)
  messagesHandled Int     @default(0)
  marketingPosts Int      @default(0)
  incidents     Int       @default(0)
  details       String    @default("{}")
  createdAt     DateTime  @default(now())
}

model Message {
  id            String    @id @default(cuid())
  customerName  String
  customerEmail String?
  subject       String
  body          String
  reply         String?
  status        String    @default("pending")
  handledBy     String?
  orderId       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
}
